API_PORT=3000
MYSQL_PORT=3307
MYSQL_DATABASE=membership_store
MYSQL_USER=membership_dev
MYSQL_PASSWORD=replace_with_local_app_password
MYSQL_ROOT_PASSWORD=replace_with_local_root_password
# Match MYSQL_USER / MYSQL_PASSWORD / MYSQL_PORT / MYSQL_DATABASE above.
# Percent-encode reserved characters in the DATABASE_URL username/password.
DATABASE_URL=mysql://membership_dev:replace_with_local_app_password@127.0.0.1:3307/membership_store
APP_BASE_URL=http://localhost:5173
ADMIN_EMAIL=owner@example.com
# 12-128 characters; bootstrap only. Later seeds never reset an existing password.
ADMIN_PASSWORD=replace_with_local_admin_password
# Optional absolute path. Defaults to .local-data/wechat-qr under the checkout.
# WECHAT_QR_STORAGE_DIR=/absolute/path/to/membership-data/wechat-qr
