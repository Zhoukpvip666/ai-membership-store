# Root-owned backup.env, mode 0600.
RESTIC_REPOSITORY=sftp:membership-offsite:/approved/repository
RESTIC_PASSWORD_FILE=/etc/ai-membership-store/restic-password
# S3 alternative: s3:https://storage.example.com/bucket/membership-store
# Use AWS_SHARED_CREDENTIALS_FILE with a separate root-owned 0600 file for S3.
