shop.example.com {
	root * /opt/ai-membership-store/current/frontend/dist

	@api path /api /api/*
	handle @api {
		reverse_proxy 127.0.0.1:3101 {
			header_up X-Forwarded-For {http.request.remote.host}
		}
	}

	@assets path /assets /assets/*
	handle @assets {
		@hashed {
			path_regexp hashed ^/assets/[^/]+-[A-Za-z0-9_-]{8,}\.[^/]+$
			file
		}
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@static path_regexp static \.[^/]+$
	handle @static {
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
