shop.example.com {
	root * /opt/ai-membership-store/current/frontend/dist
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
	}
	@secure protocol https
	header @secure Strict-Transport-Security "max-age=31536000"

	@internal path /internal /internal/*
	handle @internal {
		respond 404
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy 127.0.0.1:3101 {
			header_up X-Forwarded-For {http.request.remote.host}
		}
	}

	@assets path /assets /assets/*
	handle @assets {
		@hashed {
			path_regexp hashed ^/assets/[^/]+-[A-Za-z0-9_-]{8,}\.[^/]+$
			file {
				root /opt/ai-membership-store/immutable
			}
		}
		handle @hashed {
			root * /opt/ai-membership-store/immutable
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		handle {
			header Cache-Control "no-cache"
			file_server
		}
	}

	@static path_regexp static \.[^/]+$
	handle @static {
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
