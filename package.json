{
  "name": "ai-membership-store",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "npm run db:generate",
    "dev": "concurrently --kill-others-on-fail --names web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm run dev -w frontend",
    "dev:api": "npm run dev -w backend",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces && tsc -p tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w backend",
    "db:validate": "npm run db:validate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:status": "npm run db:status -w backend",
    "db:seed": "npm run db:seed -w backend",
    "test:db": "npm run test:db -w backend"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "concurrently": "^9.2.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
