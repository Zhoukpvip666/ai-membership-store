# Copy into a private production runtime context and replace placeholders.
# Migration, bootstrap, DBA and backup credentials belong in separate contexts.
NODE_ENV=production
APP_BASE_URL=https://shop.example.com
TRUSTED_PROXY_IP=127.0.0.1
API_PORT=3101
PRODUCTION_DATABASE_NAME=membership_production
DATABASE_URL=mysql://membership_api:replace_with_runtime_password@127.0.0.1:3310/membership_production
WECHAT_QR_STORAGE_DIR=/srv/membership-data/wechat-qr
PRODUCT_COVER_STORAGE_DIR=/srv/membership-data/product-covers
MYSQL_AUTH_PUBLIC_KEY_FILE=/etc/ai-membership-store/mysql-auth-public.pem
